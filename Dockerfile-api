# Build and run the server in background mode and follow the logs.
# https://docs.astral.sh/uv/guides/integration/docker/
# https://docs.astral.sh/uv/guides/integration/fastapi/

# docker build --tag=fastapi-server --no-cache --progress=plain . \
# && docker run --detach --publish=5001:5001 fastapi-server \
# && docker logs -f $(docker ps -lq)

# To kill the background container, run `docker kill $(docker ps -lq)`

# Use Astral's uv Debian Trixie Slim Python 3.12 base image
FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim

RUN apt-get update && apt-get install -y build-essential j2cli

RUN uv venv && uv pip install "fastapi[standard]" httpx2 pydantic pynntp beautifulsoup4 dateparser pondpond && mkdir -p /app/server

# .env is rendered at container start from the mounted config.json
# (see docker-entrypoint.sh), so no credentials end up in the image.
COPY ./tools/docker_tools/j2_related/j2_filters.py /tmp/j2_filters.py
COPY ./server_config/api_server/docker-entrypoint.sh /docker-entrypoint.sh

# Create a directory for the FastAPI app
WORKDIR /app

COPY env.j2 /app/.env.j2

# Expose port 8000
EXPOSE 8000

ENTRYPOINT ["/docker-entrypoint.sh"]

# Command to run the FastAPI server, binding it to port 5001
CMD ["uv", "run", "--env-file=.env", "fastapi", "dev", "--host=0.0.0.0", "server/main.py"]
